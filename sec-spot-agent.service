[Unit]
    Description=Sec-Spot Monitoring Agent
    After=network.target
    Wants=network-online.target

[Service]
    ExecStart=/usr/bin/python3 /usr/sec-spot/agent.py
    WorkingDirectory=/usr/sec-spot
    Restart=always
    User=root
    Group=root
    StandardOutput=append:/var/log/sec-spot.log
    StandardError=append:/var/log/sec-spot.log

    # Hardening options
    PrivateTmp=true
    ProtectSystem=full
    ReadWritePaths=/usr/sec-spot
    ProtectHome=true
    ProtectControlGroups=true
    ProtectKernelModules=true
    ProtectKernelTunables=true
    RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_PACKET
    MemoryDenyWriteExecute=true
    RestrictRealtime=true
[Install]
    WantedBy=multi-user.target