# config.env.example - Updated with batch settings
# Copy this file to config.env and adjust values as needed

# Agent identification
AGENT_VERSION=1.0.0
SERVER_ID=1

# Server connection
API_BASE_URL=http://your-server-url
REVERB_URI=ws://your-server-host:6001/app/your-app-key
REVERB_CHANNEL=your-app-key

# Monitoring settings
MONITORING_INTERVAL=60  # System metrics collection interval in seconds
RETRIES=3               # Number of connection retries

# Logging settings
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=/var/log/sec-spot-agent.log

# Security settings
SEND_ALL_LOGS=false     # Set to true to send all logs, not just errors/warnings

# Network monitoring settings
MONITOR_NETWORK_TRAFFIC=true
NETWORK_BATCH_SIZE=1000         # Maximum packets per batch (default: 1000)
NETWORK_BATCH_INTERVAL=60       # Maximum seconds between network batches (default: 60)

# Log collection batching settings
LOG_BATCH_SIZE=500              # Maximum log entries per batch (default: 500)
LOG_BATCH_INTERVAL=30           # Maximum seconds between log batches (default: 30)

# Security monitoring settings
SECURITY_CHECK_INTERVAL=300     # Security check interval in seconds

# Advanced batching settings (optional)
# ENABLE_COMPRESSION=true       # Compress batches before sending (future feature)
# MAX_BATCH_MEMORY=50MB         # Maximum memory usage for batching (future feature)
# BATCH_PRIORITY=normal         # Priority for batch sending: low, normal, high (future feature)